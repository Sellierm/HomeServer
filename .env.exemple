# ─────────────────────────────────────────────
# Credentials PIA
# ─────────────────────────────────────────────
PIA_USER=
PIA_PASSWORD=
PIA_REGION=

# ─────────────────────────────────────────────
# Système
# ─────────────────────────────────────────────
PUID=1000
PGID=1000
TZ=Europe/Paris

# ─────────────────────────────────────────────
# Racine média commune (hardlinks)
# Structure attendue :
#   /mnt/hdd/stream/
#   ├── downloads/     ← qBittorrent télécharge ici
#   ├── movies/        ← Radarr déplace ici
#   └── tv/            ← Sonarr déplace ici
# ─────────────────────────────────────────────
MEDIA_ROOT=/mnt/hdd/stream

# ─────────────────────────────────────────────
# Viniplay
# Génère une string random (ex: openssl rand -hex 32)
# ─────────────────────────────────────────────
VINIPLAY_SESSION_SECRET=
